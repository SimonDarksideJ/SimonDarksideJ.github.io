source 'https://rubygems.org'

gem 'jekyll', '~> 4.4'

# Windows timezone support (required by Jekyll on Windows)
gem 'tzinfo', platforms: [:windows]
gem 'tzinfo-data', platforms: [:windows]

# Windows file watcher (avoids polling)
gem 'wdm', '>= 0.1.0', platforms: [:windows]

group :jekyll_plugins do
  gem 'jekyll-paginate'
  gem 'jekyll-feed', '~> 0.18'
  gem 'jekyll-sitemap'
  gem 'jekyll-seo-tag'
  gem 'jekyll-archives'
end
